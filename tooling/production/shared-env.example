# Copy to:
# /home/u188101251/production-app/shared/.env.production
# chmod 600 after creation. Never commit real values.

# CMS database - use either URL or discrete MySQL settings.
DGS_DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# DGS_MYSQL_HOST=
# DGS_MYSQL_PORT=3306
# DGS_MYSQL_USER=
# DGS_MYSQL_PASSWORD=
# DGS_MYSQL_DATABASE=

# Native CMS admin
DGS_ADMIN_EMAIL=replace-with-admin-email
DGS_ADMIN_PASSWORD=replace-with-strong-password
DGS_ADMIN_SESSION_SECRET=replace-with-long-random-secret

# SMTP for native career notifications
DGS_SMTP_HOST=replace-with-smtp-host
DGS_SMTP_PORT=587
DGS_SMTP_SECURE=false
DGS_SMTP_USER=replace-with-smtp-user
DGS_SMTP_PASSWORD=replace-with-smtp-password
DGS_SMTP_FROM=D'Genius Solutions <replace-with-sender>
DGS_CAREER_NOTIFICATION_TO=hr@dgeniussolutions.com
