{
  "name": "dgs-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "extract:wordpress": "node scripts/extract-wordpress.mjs",
    "normalize:wordpress": "node scripts/normalize-wordpress-content.mjs",
    "extract:envira": "node scripts/extract-public-envira-evidence.mjs",
    "audit:live": "node scripts/audit-live-site-v2.mjs",
    "audit:targets": "node scripts/audit-linked-and-canonical-targets.mjs",
    "audit:tier0": "node scripts/audit-tier0-live-pages.mjs",
    "audit:analytics": "node scripts/audit-live-analytics.mjs",
    "audit:performance": "node scripts/audit-live-performance.mjs",
    "audit:accessibility": "node scripts/audit-live-accessibility.mjs",
    "build:tier0-content": "node scripts/build-tier0-content-baseline.mjs",
    "build:route-parity": "node scripts/build-route-parity-v2.mjs",
    "build:indexability": "node scripts/build-indexability-manifest.mjs",
    "build:links": "node scripts/build-link-graph.mjs",
    "build:route-registry": "node scripts/build-nextjs-route-registry.mjs",
    "build:page-template-map": "node scripts/build-page-template-map.mjs",
    "build:content-blocks": "node scripts/build-content-blocks.mjs",
    "verify:tier0": "node scripts/verify-tier0-baseline.mjs",
    "verify:tier0-preview": "node scripts/compare-tier0-preview.mjs",
    "validate:redirects": "node scripts/validate-redirects.mjs",
    "validate:search": "node scripts/validate-search-architecture.mjs",
    "validate:forms": "node scripts/validate-forms-readiness.mjs",
    "validate:portfolio": "node scripts/validate-portfolio-readiness.mjs",
    "validate:envira-runtime": "node scripts/validate-envira-runtime.mjs",
    "build:portfolio-alt-review": "node scripts/build-portfolio-alt-review.mjs",
    "build:portfolio-review": "node scripts/build-portfolio-review.mjs",
    "validate:analytics": "node scripts/validate-analytics-readiness.mjs",
    "release:validate:search": "node scripts/validate-release-readiness.mjs",
    "release:validate": "npm run release:validate:search && npm run validate:forms && npm run validate:portfolio && npm run validate:analytics",
    "migration:baseline": "npm run extract:wordpress && npm run normalize:wordpress && npm run extract:envira && npm run audit:live && npm run audit:targets && npm run audit:tier0 && npm run audit:analytics && npm run audit:performance && npm run audit:accessibility && npm run build:content-blocks && npm run build:tier0-content && npm run build:route-parity && npm run build:indexability && npm run build:links && npm run build:route-registry && npm run verify:tier0 && npm run validate:redirects && npm run validate:search",
    "check": "npm run validate:redirects && npm run validate:search && npm run lint && npm run typecheck && npm run build",
    "capture:wp-visual": "node scripts/capture-wp-visual-reference.mjs",
    "capture:next-visual": "node scripts/capture-next-visual-reference.mjs",
    "compare:visual": "node scripts/compare-visual-reference.mjs",
    "compare:homepage-content": "node scripts/compare-homepage-content.mjs",
    "inventory:homepage-structure": "node scripts/inventory-homepage-structure.mjs",
    "diff:homepage-structure": "node scripts/diff-homepage-structure.mjs",
    "wp-mirror:inventory": "node scripts/inventory-homepage-structure.mjs both && node scripts/diff-homepage-structure.mjs",
    "wp-exact:extract": "node scripts/extract-wp-exact-mirror.mjs",
    "wp-exact:extract-assets": "node scripts/extract-wp-homepage-assets.mjs",
    "wp-exact:compare": "node scripts/compare-wp-exact-sections.mjs",
    "visual-parity:capture": "npm run capture:wp-visual && npm run capture:next-visual",
    "visual-parity:compare": "npm run compare:homepage-content && npm run compare:visual",
    "capture:ui-lock-baseline": "node scripts/capture-ui-lock-baseline.mjs",
    "validate:ui-lock": "node scripts/validate-ui-lock.mjs",
    "audit:tier0-migration": "node scripts/audit-tier0-migration.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "16.3.3",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "cheerio": "1.2.0",
    "eslint": "9.32.0",
    "eslint-config-next": "16.3.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "5.9.3"
  }
