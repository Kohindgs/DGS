<div>\r\n<div style=\"font-size:clamp(0.75rem,1.3vw,0.8rem);font-weight:400;letter-spacing:1px;color:rgba(255,255,255,0.35);text-transform:uppercase;margin-bottom:8px\">Location</div>\r\n<div style=\"font-size:clamp(0.95rem,1.7vw,1.05rem);font-weight:300;color:rgba(255,255,255,0.75)\">Khar West, Mumbai</div>\r\n</div>\r\n<div>\r\n<div style=\"font-size:clamp(0.75rem,1.3vw,0.8rem);font-weight:400;letter-spacing:1px;color:rgba(255,255,255,0.35);text-transform:uppercase;margin-bottom:8px\">Experience</div>\r\n<div style=\"font-size:clamp(0.95rem,1.7vw,1.05rem);font-weight:300;color:rgba(255,255,255,0.75)\">0–6 years</div>\r\n</div>\r\n<div>\r\n<div style=\"font-size:clamp(0.75rem,1.3vw,0.8rem);font-weight:400;letter-spacing:1px;color:rgba(255,255,255,0.35);text-transform:uppercase;margin-bottom:8px\">Schedule</div>\r\n<div style=\"font-size:clamp(0.95rem,1.7vw,1.05rem);font-weight:300;color:rgba(255,255,255,0.75)\">Monday – Friday</div>\r\n</div>\r\n<div>\r\n<div style=\"font-size:clamp(0.75rem,1.3vw,0.8rem);font-weight:400;letter-spacing:1px;color:rgba(255,255,255,0.35);text-transform:uppercase;margin-bottom:8px\">Compensation</div>\r\n<div style=\"font-size:clamp(0.95rem,1.7vw,1.05rem);font-weight:300;color:rgba(255,255,255,0.75)\">Negotiable</div>\r\n</div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"job-arrow-wrapper\" style=\"position:relative;padding:2px;background:linear-gradient(135deg,#ff6b35,#ff2e97,#9d4edd,#4361ee);border-radius:50%;width:clamp(70px,10vw,90px);height:clamp(70px,10vw,90px);flex-shrink:0;transition:all 0.5s ease\">\r\n<div class=\"job-arrow-glow\" style=\"position:absolute;inset:-3px;background:linear-gradient(135deg,#ff6b35,#ff2e97,#9d4edd,#4361ee);border-radius:50%;opacity:0;transition:opacity 0.5s ease;filter:blur(8px);z-index:-1\"></div>\r\n<div style=\"position:relative;display:flex;align-items:center;justify-content:center;width:100%;height:100%;background:rgba(10,10,10,0.95);border-radius:50%;transition:all 0.5s ease\" class=\"job-arrow\">\r\n<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" style=\"width:clamp(24px,3vw,32px);height:clamp(24px,3vw,32px);color:rgba(255,255,255,0.6);transition:all 0.5s ease\">\r\n<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3\"/>\r\n</svg>\r\n</div>\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n<!-- Coming Soon Placeholder -->\r\n<div style=\"position:relative;background:transparent;border:1px dashed rgba(255,255,255,0.08);border-radius:0;padding:clamp(60px,8vw,100px);text-align:center\">\r\n<div style=\"font-size:clamp(1.1rem,2.2vw,1.4rem);font-weight:300;color:rgba(255,255,255,0.25);margin-bottom:12px;letter-spacing:-0.01em\">More positions opening soon</div>\r\n<div style=\"width:60px;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.15),transparent);margin:0 auto\"></div>\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n</section>\r\n\r\n<!-- JOB MODAL -->\r\n<div class=\"job-modal-overlay\" id=\"modal-hr-generalist\" data-modal-id=\"hr-generalist\" style=\"position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.98);z-index:999999;display:none;align-items:flex-start;justify-content:center;padding:0;box-sizing:border-box;overflow-y:auto;backdrop-filter:blur(30px)\">\r\n\r\n<div class=\"job-modal-content\" style=\"position:relative;max-width:900px;width:100%;background:rgba(10,10,10,0.98);border-left:1px solid rgba(255,255,255,0.06);border-right:1px solid rgba(255,255,255,0.06);min-height:100vh\">\r\n\r\n<button class=\"job-modal-close\" data-close=\"hr-generalist\" style=\"position:fixed;top:40px;right:40px;width:50px;height:50px;background:transparent;border:1px solid rgba(255,255,255,0.1);border-radius:0;color:rgba(255,255,255,0.6);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk',sans-serif;transition:all 0.3s ease;font-weight:200;z-index:10000000;line-height:1\">×</button>\r\n\r\n<div style=\"padding:clamp(80px,10vw,120px) clamp(40px,7vw,100px)\">\r\n\r\n<!-- Header -->\r\n<div style=\"margin-bottom:clamp(60px,10vw,90px)\">\r\n<div style=\"position:relative;display:inline-block;margin-bottom:25px\">\r\n<span style=\"font-size:clamp(0.7rem,1.2vw,0.75rem);font-weight:400;letter-spacing:2px;color:rgba(255,255,255,0.4);text-transform:uppercase\">Full-time Position</span>\r\n<div style=\"position:absolute;bottom:-6px;left:0;width:60%;height:1px;background:linear-gradient(90deg,#ff6b35,#ff2e97)\"></div>\r\n</div>\r\n<h2 style=\"font-size:clamp(3rem,6vw,5rem);font-weight:200;color:#fff;margin-bottom:30px;line-height:1;letter-spacing:-0.03em\">\r\nJunior HR<br>\r\n<span style=\"background:linear-gradient(135deg,#ff6b35,#ff8c42,#ffa85c);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;display:inline-block\">Generalist</span>\r\n</h2>\r\n<div style=\"display:flex;flex-wrap:wrap;gap:clamp(20px,4vw,30px);font-size:clamp(0.9rem,1.6vw,1rem);color:rgba(255,255,255,0.45)\">\r\n<span>Bandra West, Mumbai</span>\r\n<span style=\"color:rgba(255,255,255,0.2)\">—</span>\r\n<span>Monday – Friday</span>\r\n<span style=\"color:rgba(255,255,255,0.2)\">—</span>\r\n<span>On-site</span>\r\n</div>\r\n</div>\r\n\r\n<!-- Overview -->\r\n<div style=\"margin-bottom:clamp(60px,9vw,90px)\">\r\n<div style=\"position:relative;display:inline-block;margin-bottom:25px\">\r\n<h3 style=\"font-size:clamp(0.8rem,1.4vw,0.9rem);font-weight:400;color:rgba(255,255,255,0.8);letter-spacing:2px;text-transform:uppercase;margin:0\">Overview</h3>\r\n<div style=\"position:absolute;bottom:-8px;left:0;width:50px;height:1px;background:linear-gradient(90deg,#9d4edd,#4361ee)\"></div>\r\n</div>\r\n<p style=\"font-size:clamp(1.1rem,2vw,1.3rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.65)\">\r\nAs a Junior HR Executive, you'll be at the heart of our daily HR functions — from tracking attendance to onboarding new hires, managing documentation, and supporting recruitment drives.\r\n</p>\r\n</div>\r\n\r\n<!-- Responsibilities -->\r\n<div style=\"margin-bottom:clamp(60px,9vw,90px)\">\r\n<div style=\"position:relative;display:inline-block;margin-bottom:30px\">\r\n<h3 style=\"font-size:clamp(0.8rem,1.4vw,0.9rem);font-weight:400;color:rgba(255,255,255,0.8);letter-spacing:2px;text-transform:uppercase;margin:0\">Key Responsibilities</h3>\r\n<div style=\"position:absolute;bottom:-8px;left:0;width:50px;height:1px;background:linear-gradient(90deg,#ff6b35,#ff8c42)\"></div>\r\n</div>\r\n<div style=\"display:grid;gap:clamp(15px,2.5vw,20px)\">\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#ff6b35,rgba(255,107,53,0.3))\"></div>\r\nMaintain and update employee attendance, leaves, and timesheets\r\n</div>\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#ff6b35,rgba(255,107,53,0.3))\"></div>\r\nAddress employee queries, grievances, and support requests\r\n</div>\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#ff6b35,rgba(255,107,53,0.3))\"></div>\r\nManage HR documentation (offer letters, ID cards, relieving letters)\r\n</div>\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#ff6b35,rgba(255,107,53,0.3))\"></div>\r\nConduct background verifications and validate candidate documents\r\n</div>\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#ff6b35,rgba(255,107,53,0.3))\"></div>\r\nAssist with recruitment: sourcing, scheduling, and follow-ups\r\n</div>\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#ff6b35,rgba(255,107,53,0.3))\"></div>\r\nOversee smooth onboarding of new employees\r\n</div>\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#ff6b35,rgba(255,107,53,0.3))\"></div>\r\nPlan and execute monthly employee engagement activities\r\n</div>\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#ff6b35,rgba(255,107,53,0.3))\"></div>\r\nKeep HR records compliant and well-organized (digital & physical)\r\n</div>\r\n</div>\r\n</div>\r\n\r\n<!-- Requirements -->\r\n<div style=\"margin-bottom:clamp(60px,9vw,90px)\">\r\n<div style=\"position:relative;display:inline-block;margin-bottom:30px\">\r\n<h3 style=\"font-size:clamp(0.8rem,1.4vw,0.9rem);font-weight:400;color:rgba(255,255,255,0.8);letter-spacing:2px;text-transform:uppercase;margin:0\">Requirements</h3>\r\n<div style=\"position:absolute;bottom:-8px;left:0;width:50px;height:1px;background:linear-gradient(90deg,#ff2e97,#9d4edd)\"></div>\r\n</div>\r\n<div style=\"display:grid;gap:clamp(15px,2.5vw,20px)\">\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#9d4edd,rgba(157,78,221,0.3))\"></div>\r\n0–6 years of experience in HR Generalist or HR Operations\r\n</div>\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#9d4edd,rgba(157,78,221,0.3))\"></div>\r\nGraduate or Postgraduate in HR / BBA / MBA or relevant field\r\n</div>\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#9d4edd,rgba(157,78,221,0.3))\"></div>\r\nExcellent verbal and written communication skills\r\n</div>\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#9d4edd,rgba(157,78,221,0.3))\"></div>\r\nProficient in MS Excel, Word & Google Workspace\r\n</div>\r\n<div style=\"position:relative;padding-left:30px;font-size:clamp(1rem,1.8vw,1.1rem);font-weight:300;line-height:1.7;color:rgba(255,255,255,0.6)\">\r\n<div style=\"position:absolute;left:0;top:13px;width:12px;height:1px;background:linear-gradient(90deg,#9d4edd,rgba(157,78,221,0.3))\"></div>\r\nWell-organized, proactive, approachable, and people-friendly\r\n</div>\r\n</div>\r\n</div>\r\n\r\n<!-- Benefits -->\r\n<div style=\"margin-bottom:clamp(60px,9vw,90px)\">\r\n<div style=\"position:relative;display:inline-block;margin-bottom:30px\">\r\n<h3 style=\"font-size:clamp(0.8rem,1.4vw,0.9rem);font-weight:400;color:rgba(255,255,255,0.8);letter-spacing:2px;text-transform:uppercase;margin:0\">What We Offer</h3>\r\n<div style=\"position:absolute;bottom:-8px;left:0;width:50px;height:1px;background:linear-gradient(90deg,#4361ee,#9d4edd)\"></div>\r\n</div>\r\n<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:clamp(15px,2.5vw,20px)\">\r\n<div style=\"padding:clamp(18px,3vw,22px);background:rgba(255,107,53,0.03);border:1px solid rgba(255,107,53,0.08);font-size:clamp(0.95rem,1.7vw,1.05rem);font-weight:300;color:rgba(255,255,255,0.6);line-height:1.6\">Collaborative culture</div>\r\n<div style=\"padding:clamp(18px,3vw,22px);background:rgba(157,78,221,0.03);border:1px solid rgba(157,78,221,0.08);font-size:clamp(0.95rem,1.7vw,1.05rem);font-weight:300;color:rgba(255,255,255,0.6);line-height:1.6\">Career growth</div>\r\n<div style=\"padding:clamp(18px,3vw,22px);background:rgba(255,46,151,0.03);border:1px solid rgba(255,46,151,0.08);font-size:clamp(0.95rem,1.7vw,1.05rem);font-weight:300;color:rgba(255,255,255,0.6);line-height:1.6\">Team activities</div>\r\n<div style=\"padding:clamp(18px,3vw,22px);background:rgba(67,97,238,0.03);border:1px solid rgba(67,97,238,0.08);font-size:clamp(0.95rem,1.7vw,1.05rem);font-weight:300;color:rgba(255,255,255,0.6);line-height:1.6\">Prime location</div>\r\n</div>\r\n</div>\r\n\r\n<!-- Application Form -->\r\n<div style=\"padding:clamp(45px,7vw,60px);background:rgba(255,255,255,0.015);border:1px solid rgba(255,255,255,0.05)\">\r\n<div style=\"margin-bottom:35px\">\r\n<div style=\"position:relative;display:inline-block;margin-bottom:20px\">\r\n<h3 style=\"font-size:clamp(1.4rem,2.8vw,1.8rem);font-weight:300;color:#fff;letter-spacing:-0.01em;margin:0\">Apply for this position</h3>\r\n<div style=\"position:absolute;bottom:-10px;left:0;width:70px