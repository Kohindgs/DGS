# Public migration source
DGS_SOURCE_URL=https://www.dgeniussolutions.com
WP_REST_BASE_URL=https://www.dgeniussolutions.com/wp-json/wp/v2

# Safety: previews/staging default to noindex.
# Set to true only for explicitly approved production cutover.
DGS_PUBLIC_INDEXING=false

# Optional audit target when checking a running Next preview.
MIGRATION_TARGET_URL=http://127.0.0.1:3000

# Never place WordPress Application Passwords, Hostinger tokens or other secrets in this committed file.

# Native CMS database
# DGS_DATABASE_URL=mysql://user:password@host:3306/database

# Native career application storage (keep outside public/)
# DGS_PRIVATE_UPLOAD_DIR=/absolute/private/path/careers

# SMTP notifications for native career applications
# DGS_SMTP_HOST=smtp.example.com
# DGS_SMTP_PORT=587
# DGS_SMTP_SECURE=false
# DGS_SMTP_USER=notifications@example.com
# DGS_SMTP_PASSWORD=replace-me
# DGS_SMTP_FROM=D'Genius Solutions <notifications@example.com>
# DGS_CAREER_NOTIFICATION_TO=hr@dgeniussolutions.com
